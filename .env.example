# LILITH Environment Configuration
# Copy this file to .env and fill in your values

# OpenWeatherMap API Key (free tier: https://openweathermap.org/api)
# Optional secondary fallback; Open-Meteo reference forecasts are keyless
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY_HERE

# Path to trained model checkpoint (optional, uses fallback if not set)
# Download the pre-trained model from the releases or train your own
LILITH_CHECKPOINT=checkpoints/lilith_best.pt

# Single-host pilot: mount a persistent writable disk at this path
LILITH_LEDGER_PATH=data/storage/forecast-ledger.sqlite3
LILITH_GHCN_CACHE=data/raw/ghcn_records
# Legacy naive serving timestamps are currently interpreted as UTC
TZ=UTC
